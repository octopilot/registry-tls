# armv7 variant: registry + nginx TLS proxy (Envoy does not publish armv7).
# Same behavior as main Dockerfile; certs generated at startup.
FROM registry:2 AS registry
FROM debian:bookworm-slim

COPY --from=registry /bin/registry /bin/registry

# Use Debian's python3-cryptography to avoid building cffi from source (no gcc on armv7).
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates nginx python3 python3-cryptography \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

COPY config.yml /etc/docker/registry/config.yml
COPY nginx.conf /etc/nginx/nginx.conf
COPY entrypoint.py /entrypoint.py
RUN chmod +x /entrypoint.py && mkdir -p /etc/envoy/certs

EXPOSE 5001

ENTRYPOINT ["python3", "/entrypoint.py"]
